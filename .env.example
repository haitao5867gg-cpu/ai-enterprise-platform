# Copy to .env for local overrides. Never commit .env.
# Settings read by the API all start with AEP_ (see backend/src/aep/config.py).
AEP_ENV=local
# Model provider keys arrive in M1 (LiteLLM gateway), for example:
# OPENAI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
