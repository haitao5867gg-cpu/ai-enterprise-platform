# Copy to .env for local overrides. Never commit .env.
# Settings read by the API all start with AEP_ (see backend/src/aep/config.py).
AEP_ENV=local
# Model alias the API uses when a caller names none (see infra/litellm/config.yaml).
AEP_DEFAULT_MODEL=mock

# --- Model gateway (LiteLLM) ---
# Shared secret between the API and the gateway. Change it outside local dev.
LITELLM_MASTER_KEY=sk-local-dev

# Fill in only the providers you use; the rest stay unavailable.
# Model ids below are defaults from docker-compose.yml; override them here.
OPENAI_API_KEY=
# OPENAI_MODEL=openai/gpt-5

AZURE_API_KEY=
AZURE_API_BASE=
# AZURE_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_MODEL=azure/<your-deployment-name>

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1
# BEDROCK_CLAUDE_MODEL=bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0

DASHSCOPE_API_KEY=
# QWEN_MODEL=dashscope/qwen-plus

DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek/deepseek-chat

# Company OpenAI-compatible gateway (alias "company"); the base URL ends in /v1.
COMPANY_API_BASE=
COMPANY_API_KEY=
# COMPANY_MODEL=openai/deepseek-v4.1-flash-new

# --- Databricks dev validation ---
# With host and token set, every generated ETL bundle is deployed to the dev
# target and run once; without them that step is skipped. Use a PAT or a
# service principal's token; in Azure it comes from Key Vault.
# AEP_DATABRICKS_HOST=https://adb-<workspace-id>.<n>.azuredatabricks.net
# AEP_DATABRICKS_TOKEN=
# Where dev runs put their tables and read their sources (bundle defaults if empty).
# AEP_DATABRICKS_CATALOG=
# AEP_DATABRICKS_SCHEMA=
# AEP_DATABRICKS_SOURCE_CATALOG=
# Classic pipeline compute instead of serverless, e.g. Standard_DS3_v2 (Azure China
# has no serverless pipelines). Users who may create clusters only through a
# cluster policy also set its id; the policy may then fix the node type.
# AEP_DATABRICKS_PIPELINE_NODE_TYPE=
# AEP_DATABRICKS_PIPELINE_WORKERS=1
# AEP_DATABRICKS_PIPELINE_POLICY_ID=
# Without permission to create clusters: an existing cluster. The bundle then
# becomes a notebook job on that cluster, deployed and run on the dev target
# (writes the tables). AEP_DATABRICKS_DEPLOY=cluster only runs the transformations
# on it once, writing nothing; =pipeline keeps the Lakeflow pipeline.
# AEP_DATABRICKS_CLUSTER_ID=
# AEP_DATABRICKS_DEPLOY=
# The prod target. With catalog and schema set, a bundle that passed on dev waits
# for a person to approve its release, then goes to prod as a scheduled job (or
# pipeline plus refresh job) without running at once. Not in cluster mode. The
# job uses AEP_DATABRICKS_CLUSTER_ID unless a prod cluster is given; the schedule
# is Quartz cron (default every day at 2:00).
# AEP_DATABRICKS_PROD_CATALOG=
# AEP_DATABRICKS_PROD_SCHEMA=
# AEP_DATABRICKS_PROD_CLUSTER_ID=
# AEP_DATABRICKS_PROD_SCHEDULE=0 0 2 * * ?
# AEP_DATABRICKS_PROD_TIMEZONE=Asia/Shanghai

# --- Assets repository ---
# Bundles that pass on dev are opened as pull requests under pipelines/<name>/.
# Off unless both are set. Use a fine-grained token for this repository only, with
# Contents and Pull requests read/write. The repository needs an initial commit.
# AEP_ASSETS_REPO=owner/aep-assets
# AEP_ASSETS_GITHUB_TOKEN=
# AEP_ASSETS_BASE_BRANCH=main
# Where people open the workbench; PRs link back to the run there.
# AEP_WEB_URL=http://localhost:3000

# --- Tracing (Langfuse) ---
# `make up-full` starts a local Langfuse and sets these itself. To trace to
# Langfuse Cloud or another server with `make up`, set all three.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# Browser-facing trace links (web runtime); set the UI URL empty to hide them.
AEP_LANGFUSE_UI_URL=http://localhost:3100
AEP_LANGFUSE_PROJECT_ID=aep-local
