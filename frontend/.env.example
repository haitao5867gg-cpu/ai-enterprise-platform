# Next.js server only. Not exposed as NEXT_PUBLIC_* variables.
AEP_API_INTERNAL_URL=http://localhost:8000
# Browser-facing trace links (server runtime); set the UI URL empty to hide them.
AEP_LANGFUSE_UI_URL=http://localhost:3100
AEP_LANGFUSE_PROJECT_ID=aep-local
# Only honored by next dev; disabled by default and always ignored in production.
AEP_MOCK_RUNS=false
