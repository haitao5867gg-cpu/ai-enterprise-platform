# 运行包的设置（infra/runtime/README.md）。install.sh 第一次运行时复制成
# infra/runtime/.env（权限 600，不进仓库），生成下面的随机口令，再问域名、平台公钥和模型网关。

# 对外的域名。没有自己的域名就用 <IP 用横线连接>.sslip.io。
AEP_DOMAIN=

# 平台的公钥（JSON 数组，base64 原始公钥），只认这些钥匙签的流程包。
# 从平台的 GET /packages/public-key 拿；换钥匙时可以同时放新旧两把。
AEP_PLATFORM_PUBLIC_KEYS=[]

# 这台机器的数据库口令和模型网关的口令，install.sh 生成，之后不要改。
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=
# 加密在网关里保存的模型 key，生成后不能改。
LITELLM_SALT_KEY=

# 模型网关（别名 company，OpenAI 兼容）。流程要的别名都要在 infra/litellm/config.yaml 里。
COMPANY_API_BASE=
COMPANY_API_KEY=
# COMPANY_MODEL=openai/deepseek-v4.1-flash-new

# 语音转写（docs/api/transcription.md）。本地转写服务 asr 要打开 profile 才启动：
# COMPOSE_PROFILES=asr
# 它第一次启动时下载的模型（small 约 500 MB；内存够时换 Systran/faster-whisper-medium 更准）。
# ASR_MODEL=Systran/faster-whisper-small
# 下载慢时换 Hugging Face 镜像站。
# HF_ENDPOINT=https://hf-mirror.com
# 用别的转写服务时改这三项（OpenAI 兼容，回答里要有每句的时间）。
# TRANSCRIBE_MODEL=openai/whisper-1
# TRANSCRIBE_API_BASE=https://api.openai.com/v1
# TRANSCRIBE_API_KEY=
# 外发策略里可以发给模型的媒体：audio、image，逗号分隔，空为都不允许。
# AEP_DATA_MEDIA=audio,image
# 节点没写模型时用的别名。
AEP_DEFAULT_MODEL=mock

# 外部应用自己的连接器（compose.app.yml 里的服务），JSON 数组，"服务名:端口"。
# 绑定连接器时只能用这里列出的地址（docs/api/datasources.md）。
AEP_CONNECTOR_HOSTS=[]

# 外部应用调运行包时用的密钥（流程里的「应用密钥」）用 aep-runtime.sh secret 填，不写在这里。
